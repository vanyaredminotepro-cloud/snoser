# Telegram bot token for control panel
TG_BOT_TOKEN=

# TikTok credentials
TIKTOK_LOGIN=
TIKTOK_PASSWORD=

# TikTok profile URL for stats collection (public profile URL)
TIKTOK_PROFILE_URL=

# Optional paths
TIKTOK_QUEUE_DIR=tiktok_queue
TIKTOK_SQLITE_PATH=app/storage/tiktok_stats.sqlite3
TIKTOK_SESSION_PATH=app/storage/tiktok_auth.json
TIKTOK_STATE_FILE=app/storage/tiktok_runtime_settings.json

# Browser mode: 1=headless, 0=visible
TIKTOK_HEADLESS=1
